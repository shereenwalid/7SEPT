        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="FastAPI Service (agent_api)&#xa;&#xa;POST /process/{opp}   · run workflow&#xa;GET  /status/{opp}    · live progress&#xa;GET  /result/{opp}    · shaped result&#xa;POST /log             · session log (Begin)&#xa;POST /feedback/{opp}  · raise request&#xa;GET  /feedback/{opp}  · list requests&#xa;GET  /exists/{opp}    · opp folder check&#xa;GET  /health&#xa;retry: 429 backoff · size auto-shrink" vertex="1">
          <mxGeometry height="190" width="300" x="520" y="120" as="geometry" />
        </mxCell>
        <mxCell id="adk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontSize=10;fontStyle=1;spacingTop=6;" value="ADK 2.x Orchestration — root_agent Workflow&#xa;retrieval → product_code → extraction → email" vertex="1">
          <mxGeometry height="510" width="590" x="520" y="330" as="geometry" />
